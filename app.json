{
  "expo": {
    "name": "GR Packers",
    "slug": "GRPackersMovers",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/apico.png",
    "scheme": "grpackersmovers",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to share live driver updates.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We use your location in the background to share live driver updates during an active trip.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foregroundCopy.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "package": "com.grpackersmovers"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "splash": {
      "image": "./assets/images/PackersMoversLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F8FAFC",
      "translucent": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/PackersMoversLogo.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC",
          "dark": {
            "backgroundColor": "#F8FAFC"
          }
        }
      ],
      "./plugins/with-text-recognition-sdk",
      "./plugins/with-android-build-optimizations",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
